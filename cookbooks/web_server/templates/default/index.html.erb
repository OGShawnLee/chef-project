<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= node['web_server']['site_title'] rescue 'Servidor Web Automatizado con Chef Infra' %></title>

  <!-- Tipografía Serif Clásica para Titulares Editoriales -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,400;1,600&display=swap" rel="stylesheet">

  <style>
    /* --------------------------------------------------------------------------
       TIPOGRAFÍAS LOCALES: RANADE (CUERPO) & NORDWAND MONO (DATOS DEV)
       -------------------------------------------------------------------------- */
    @font-face {
      font-family: 'Ranade';
      src: url('./Fonts/Ranade-Light.woff2') format('woff2');
      font-weight: 300;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'Ranade';
      src: url('./Fonts/Ranade-Regular.woff2') format('woff2');
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'Ranade';
      src: url('./Fonts/Ranade-Medium.woff2') format('woff2');
      font-weight: 500;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'Ranade';
      src: url('./Fonts/Ranade-Bold.woff2') format('woff2');
      font-weight: 700;
      font-style: normal;
      font-display: swap;
    }

    @font-face {
      font-family: 'Nordwand Mono';
      src: url('./Fonts/NordwandMono-Light.woff2') format('woff2');
      font-weight: 300;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'Nordwand Mono';
      src: url('./Fonts/NordwandMono-Regular.woff2') format('woff2');
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'Nordwand Mono';
      src: url('./Fonts/NordwandMono-Medium.woff2') format('woff2');
      font-weight: 500;
      font-style: normal;
      font-display: swap;
    }

    /* --------------------------------------------------------------------------
       PALETA EDITORIAL EXTRAÍDA DE LA ILUSTRACIÓN (ALABASTRO, TERRACOTA Y TEAL)
       -------------------------------------------------------------------------- */
    :root {
      --bg-paper: #f4efe6;          /* Papel editorial cálido (óptimo para proyector) */
      --bg-sand: #dfd8cc;           /* Tono exacto del lienzo de la ilustración */
      --bg-card: #faf7f2;           /* Blanco marfil suave para tarjetas */
      --ink-black: #1c1b1a;         /* Negro carbón profundo */
      --ink-body: #4a4640;          /* Gris piedra cálido para lectura */
      --ink-muted: #7a7368;         /* Tono secundario sutil */
      --terracotta: #c86d63;        /* Rosa terracota de la columna jónica */
      --terracotta-soft: rgba(200, 109, 99, 0.12);
      --teal: #2b5b66;              /* Azul petróleo / verde mar del pedestal */
      --teal-soft: rgba(43, 91, 102, 0.1);
      --border: rgba(28, 27, 26, 0.13);
      --border-strong: rgba(28, 27, 26, 0.28);

      --font-serif: 'Cormorant Garamond', Georgia, serif;
      --font-sans: 'Ranade', -apple-system, BlinkMacSystemFont, sans-serif;
      --font-mono: 'Nordwand Mono', ui-monospace, SFMono-Regular, Consolas, monospace;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    ::selection {
      background: var(--terracotta);
      color: #ffffff;
    }

    body {
      background-color: var(--bg-paper);
      color: var(--ink-black);
      font-family: var(--font-sans);
      font-weight: 400;
      line-height: 1.75;
      min-height: 100vh;
      padding: 3rem 2rem 6rem;
      position: relative;
      -webkit-font-smoothing: antialiased;
    }

    /* Cuadrícula arquitectónica muy sutil sobre papel claro */
    body::before {
      content: "";
      position: fixed;
      inset: 0;
      background-image:
        linear-gradient(to right, rgba(28, 27, 26, 0.035) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(28, 27, 26, 0.035) 1px, transparent 1px);
      background-size: 56px 56px;
      pointer-events: none;
      z-index: 0;
    }

    .page-container {
      max-width: 1040px;
      margin: 0 auto;
      position: relative;
      z-index: 1;
    }

    /* --------------------------------------------------------------------------
       CABECERA DE REVISTA EDITORIAL (MASTHEAD)
       -------------------------------------------------------------------------- */
    .masthead {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 1.35rem;
      margin-bottom: 4.5rem;
      border-bottom: 1px solid var(--ink-black);
      font-family: var(--font-mono);
      font-size: 0.74rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--ink-body);
    }

    .masthead-status {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      color: var(--teal);
      font-weight: 500;
    }

    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background-color: var(--teal);
    }

    /* --------------------------------------------------------------------------
       HERO EDITORIAL A DOS COLUMNAS
       -------------------------------------------------------------------------- */
    .hero-editorial {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 4.5rem;
      align-items: center;
      margin-bottom: 6.5rem;
      padding-bottom: 5rem;
      border-bottom: 1px solid var(--border);
    }

    @media (max-width: 860px) {
      .hero-editorial {
        grid-template-columns: 1fr;
        gap: 3rem;
      }
    }

    .hero-kicker {
      display: inline-block;
      font-family: var(--font-mono);
      font-size: 0.74rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--terracotta);
      background: var(--terracotta-soft);
      padding: 0.35rem 0.85rem;
      margin-bottom: 1.5rem;
      font-weight: 500;
    }

    .hero-title {
      font-family: var(--font-serif);
      font-size: clamp(2.6rem, 4.5vw, 3.85rem);
      font-weight: 600;
      line-height: 1.08;
      letter-spacing: -0.01em;
      color: var(--ink-black);
      margin-bottom: 1.5rem;
    }

    .hero-lead {
      font-size: 1.08rem;
      font-weight: 400;
      color: var(--ink-body);
      line-height: 1.8;
      margin-bottom: 2.25rem;
      max-width: 520px;
    }

    .idempotency-banner {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-left: 3px solid var(--teal);
      padding: 1.25rem 1.5rem;
    }

    .idempotency-banner-title {
      font-family: var(--font-mono);
      font-size: 0.78rem;
      font-weight: 500;
      color: var(--teal);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 0.35rem;
    }

    .idempotency-banner-desc {
      font-size: 0.88rem;
      color: var(--ink-body);
      line-height: 1.65;
    }

    /* Marco de Galería para la Ilustración */
    .artwork-card {
      background-color: var(--bg-sand);
      border: 1px solid var(--border-strong);
      padding: 1.5rem 1.5rem 1.25rem;
      box-shadow: 0 20px 45px rgba(28, 27, 26, 0.07);
    }

    .artwork-card img {
      width: 100%;
      height: auto;
      display: block;
      border: 1px solid rgba(28, 27, 26, 0.08);
    }

    .artwork-caption {
      margin-top: 1rem;
      padding-top: 0.75rem;
      border-top: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-family: var(--font-mono);
      font-size: 0.68rem;
      color: var(--ink-body);
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .artwork-caption span.accent {
      color: var(--terracotta);
      font-weight: 500;
    }

    /* --------------------------------------------------------------------------
       ENCABEZADOS DE SECCIÓN EDITORIAL
       -------------------------------------------------------------------------- */
    .section {
      margin-bottom: 6.5rem;
    }

    .section-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      padding-bottom: 1rem;
      margin-bottom: 2.5rem;
      border-bottom: 1px solid var(--ink-black);
    }

    .section-title {
      font-family: var(--font-serif);
      font-size: 2rem;
      font-weight: 600;
      color: var(--ink-black);
      line-height: 1.2;
    }

    .section-tag {
      font-family: var(--font-mono);
      font-size: 0.74rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--terracotta);
      font-weight: 500;
    }

    /* --------------------------------------------------------------------------
       TARJETAS DE TELEMETRÍA (OHAI)
       -------------------------------------------------------------------------- */
    .telemetry-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.75rem;
    }

    @media (max-width: 860px) {
      .telemetry-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 560px) {
      .telemetry-grid {
        grid-template-columns: 1fr;
      }
    }

    .card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      padding: 2rem 1.85rem;
      transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .card:hover {
      transform: translateY(-2px);
      border-color: var(--border-strong);
      box-shadow: 0 12px 28px rgba(28, 27, 26, 0.04);
    }

    .card-label {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--ink-muted);
      margin-bottom: 0.85rem;
    }

    .card-value {
      font-family: var(--font-mono);
      font-size: 1.35rem;
      font-weight: 500;
      color: var(--ink-black);
      margin-bottom: 0.5rem;
      overflow-wrap: break-word;
    }

    .card-sub {
      font-size: 0.85rem;
      color: var(--ink-body);
    }

    /* --------------------------------------------------------------------------
       CICLO DE EJECUCIÓN DE CHEF (4 FASES)
       -------------------------------------------------------------------------- */
    .steps-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1.75rem;
    }

    @media (max-width: 820px) {
      .steps-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 520px) {
      .steps-grid {
        grid-template-columns: 1fr;
      }
    }

    .step-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      padding: 1.75rem 1.6rem;
    }

    .step-num {
      font-family: var(--font-mono);
      font-size: 0.74rem;
      font-weight: 500;
      color: var(--terracotta);
      letter-spacing: 0.12em;
      margin-bottom: 0.65rem;
    }

    .step-title {
      font-family: var(--font-serif);
      font-size: 1.35rem;
      font-weight: 600;
      color: var(--ink-black);
      margin-bottom: 0.45rem;
    }

    .step-desc {
      font-size: 0.86rem;
      color: var(--ink-body);
      line-height: 1.65;
    }

    /* --------------------------------------------------------------------------
       DIRECTORIO DE RUTAS Y RETO DEL LABORATORIO
       -------------------------------------------------------------------------- */
    .routes-container {
      background: var(--bg-card);
      border: 1px solid var(--border);
    }

    .route-item {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 2rem;
      padding: 1.75rem 2rem;
      border-bottom: 1px solid var(--border);
      text-decoration: none;
      color: inherit;
      transition: background-color 0.2s ease;
    }

    .route-item:last-child {
      border-bottom: none;
    }

    a.route-item:hover {
      background-color: rgba(223, 216, 204, 0.35);
    }

    .route-path {
      font-family: var(--font-mono);
      font-size: 1.05rem;
      font-weight: 500;
      color: var(--ink-black);
      margin-bottom: 0.25rem;
    }

    .route-desc {
      font-size: 0.88rem;
      color: var(--ink-body);
    }

    .route-badge {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 0.45rem 1rem;
      border: 1px solid;
      white-space: nowrap;
    }

    .route-badge.online {
      color: var(--teal);
      background: var(--teal-soft);
      border-color: rgba(43, 91, 102, 0.3);
    }

    .route-badge.locked {
      color: var(--terracotta);
      background: var(--terracotta-soft);
      border-color: rgba(200, 109, 99, 0.35);
    }

    .challenge-note {
      margin-top: 1.5rem;
      padding: 1.25rem 1.6rem;
      background: var(--bg-sand);
      border-left: 3px solid var(--terracotta);
      font-family: var(--font-mono);
      font-size: 0.78rem;
      line-height: 1.8;
      color: var(--ink-black);
    }

    @media (max-width: 600px) {
      .route-item {
        grid-template-columns: 1fr;
        gap: 0.85rem;
      }
      .route-badge {
        justify-self: start;
      }
    }

    /* --------------------------------------------------------------------------
       PIE DE PÁGINA EDITORIAL
       -------------------------------------------------------------------------- */
    footer {
      margin-top: 6rem;
      padding-top: 2.5rem;
      border-top: 1px solid var(--ink-black);
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
      font-size: 0.88rem;
      color: var(--ink-body);
    }

    footer strong {
      color: var(--ink-black);
      font-weight: 500;
    }

    .footer-mono {
      font-family: var(--font-mono);
      font-size: 0.74rem;
      color: var(--ink-muted);
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }
  </style>
</head>
<body>

  <div class="page-container">

    <!-- Cabecera Editorial (Masthead) -->
    <header class="masthead">
      <div class="masthead-status">
        <span class="status-dot"></span>
        <span>Chef Infra • Cinc Client</span>
      </div>
      <div>Universidad Veracruzana • 7° Semestre</div>
      <div>Despliegue de Software</div>
    </header>

    <!-- Hero Principal Editorial a Dos Columnas -->
    <section class="hero-editorial">
      <div>
        <span class="hero-kicker">Infraestructura como Código (IaC)</span>
        <h1 class="hero-title"><%= node['web_server']['site_title'] rescue 'Servidor Web Automatizado con Chef Infra' %></h1>
        <p class="hero-lead">
          <%= node['web_server']['message'] rescue '&iexcl;Infraestructura desplegada exitosamente mediante C&oacute;digo (IaC) e Idempotencia!' %>
        </p>

        <div class="idempotency-banner">
          <div class="idempotency-banner-title">✓ Estado Deseado Alcanzado (Idempotencia Verificada)</div>
          <p class="idempotency-banner-desc">
            Este servidor fue aprovisionado automáticamente mediante Chef Infra. Si la receta se ejecuta nuevamente, ningún paquete ni servicio será reiniciado ni modificado innecesariamente.
          </p>
        </div>
      </div>

      <!-- Ilustración Editorial -->
      <div class="artwork-card">
        <img
          src="editorial-art.png"
          alt="Ilustración Editorial — Equilibrio e Idempotencia"
        />
        <div class="artwork-caption">
          <span>Estado Actual &amp; Estado Deseado</span>
          <span class="accent">Convergencia Activa</span>
        </div>
      </div>
    </section>

    <!-- Sección 1: Datos del Servidor (Ohai) -->
    <section class="section">
      <div class="section-header">
        <h2 class="section-title">Telemetría del Nodo</h2>
        <span class="section-tag">01 // Datos de Ohai</span>
      </div>

      <div class="telemetry-grid">
        <div class="card">
          <div class="card-label">Nodo / Hostname</div>
          <div class="card-value"><%= node['hostname'] rescue 'bookworm' %></div>
          <div class="card-sub">Identificador único en el catálogo</div>
        </div>

        <div class="card">
          <div class="card-label">Sistema Operativo</div>
          <div class="card-value"><%= node['platform'].capitalize rescue 'Debian' %> <%= node['platform_version'] rescue '12' %></div>
          <div class="card-sub">Kernel Linux <%= node['os_version'] rescue 'x86_64' %></div>
        </div>

        <div class="card">
          <div class="card-label">Dirección IP Primaria</div>
          <div class="card-value"><%= node['ipaddress'] rescue '127.0.0.1' %></div>
          <div class="card-sub">Puerto HTTP activo: <%= node['web_server']['port'] rescue 80 %></div>
        </div>

        <div class="card">
          <div class="card-label">Memoria del Sistema</div>
          <div class="card-value"><%= (node['memory']['total'].to_i / 1024 rescue '1024') %> MB</div>
          <div class="card-sub">Procesador: <%= node['cpu']['total'] rescue '1' %> Core(s)</div>
        </div>

        <div class="card">
          <div class="card-label">Entorno de Despliegue</div>
          <div class="card-value" style="color: var(--terracotta);"><%= node['web_server']['environment'] rescue 'Laboratorio' %></div>
          <div class="card-sub">Cookbook: web_server v1.0.0</div>
        </div>

        <div class="card">
          <div class="card-label">Última Convergencia</div>
          <div class="card-value" style="font-size: 1.1rem;"><%= Time.now.strftime("%Y-%m-%d %H:%M:%S") %></div>
          <div class="card-sub">Ejecutado vía Chef-Zero (Local Mode)</div>
        </div>
      </div>
    </section>

    <!-- Sección 2: Ciclo de Ejecución -->
    <section class="section">
      <div class="section-header">
        <h2 class="section-title">Ciclo de Ejecución de Chef</h2>
        <span class="section-tag">02 // Arquitectura</span>
      </div>

      <div class="steps-grid">
        <div class="step-card">
          <div class="step-num">FASE 01</div>
          <div class="step-title">Ohai Discovery</div>
          <p class="step-desc">Inspecciona automáticamente el hardware, la dirección IP, la memoria RAM y el sistema operativo.</p>
        </div>

        <div class="step-card">
          <div class="step-num">FASE 02</div>
          <div class="step-title">Compilación</div>
          <p class="step-desc">Evalúa el código Ruby DSL de la receta y construye el catálogo de recursos en memoria.</p>
        </div>

        <div class="step-card">
          <div class="step-num">FASE 03</div>
          <div class="step-title">Convergencia</div>
          <p class="step-desc">Compara el estado actual frente al estado deseado y repara únicamente las diferencias.</p>
        </div>

        <div class="step-card">
          <div class="step-num">FASE 04</div>
          <div class="step-title">Servicio Activo</div>
          <p class="step-desc">Servidor Nginx en línea y verificado en Debian 12 sin interrupciones innecesarias.</p>
        </div>
      </div>
    </section>

    <!-- Sección 3: Rutas del Servidor y Reto del Laboratorio -->
    <section class="section">
      <div class="section-header">
        <h2 class="section-title">Rutas del Servidor Web</h2>
        <span class="section-tag">03 // Nginx Endpoints</span>
      </div>

      <% easter_egg_exists = ::File.exist?("#{node['web_server']['doc_root']}/easter_egg.html") rescue false %>

      <div class="routes-container">
        <a href="/index.html" class="route-item">
          <div>
            <div class="route-path">/index.html</div>
            <div class="route-desc">Panel principal de telemetría del servidor</div>
          </div>
          <span class="route-badge online">200 OK • Activo</span>
        </a>

        <a
          id="easter-egg-row"
          href="<%= easter_egg_exists ? '/easter_egg.html' : '#easter-egg-row' %>"
          class="route-item"
          style="<%= easter_egg_exists ? '' : 'cursor: default;' %>"
        >
          <div>
            <div id="easter-egg-path" class="route-path">
              <%= easter_egg_exists ? '/easter_egg.html' : '🔒 /easter_egg.html' %>
            </div>
            <div id="easter-egg-desc" class="route-desc">
              <%= easter_egg_exists ? 'El Monumento Oculto (Desbloqueado — Haz clic para abrir)' : 'Reto final del laboratorio (Página oculta sin aprovisionar)' %>
            </div>
          </div>
          <span id="easter-egg-status" class="route-badge <%= easter_egg_exists ? 'online' : 'locked' %>">
            <%= easter_egg_exists ? '200 OK • Desbloqueado' : '404 • No encontrado' %>
          </span>
        </a>
      </div>

      <div id="easter-egg-hint" class="challenge-note" style="<%= easter_egg_exists ? 'display: none;' : '' %>">
        <strong>Reto del Laboratorio:</strong> Para publicar <code>/easter_egg.html</code>, declara el recurso <code>template</code> para <code>easter_egg.html.erb</code> dentro de <code>cookbooks/web_server/recipes/default.rb</code> y ejecuta <code>vagrant provision</code>.
      </div>
    </section>

    <!-- Pie de Página Editorial -->
    <footer>
      <div>
        Presentado por: <strong><%= node['web_server']['author'] rescue 'Equipo UV - Despliegue de Software' %></strong>
      </div>
      <div class="footer-mono">
        Debian <%= node['platform_version'] rescue '12' %> • Nginx • Chef Infra
      </div>
    </footer>

  </div>

  <!-- Comprobación en tiempo real del estado de /easter_egg.html -->
  <script>
    (function() {
      fetch('/easter_egg.html', { method: 'HEAD', cache: 'no-store' })
        .then(function(response) {
          var row = document.getElementById('easter-egg-row');
          var path = document.getElementById('easter-egg-path');
          var desc = document.getElementById('easter-egg-desc');
          var status = document.getElementById('easter-egg-status');
          var hint = document.getElementById('easter-egg-hint');

          if (response.ok) {
            row.href = '/easter_egg.html';
            row.style.cursor = 'pointer';
            path.textContent = '/easter_egg.html';
            desc.textContent = 'El Monumento Oculto (Desbloqueado — Haz clic para abrir)';
            status.className = 'route-badge online';
            status.textContent = '200 OK • Desbloqueado';
            if (hint) hint.style.display = 'none';
          } else {
            row.removeAttribute('href');
            row.style.cursor = 'default';
            path.textContent = '🔒 /easter_egg.html';
            desc.textContent = 'Reto final del laboratorio (Página oculta sin aprovisionar)';
            status.className = 'route-badge locked';
            status.textContent = '404 • No encontrado';
            if (hint) hint.style.display = 'block';
          }
        })
        .catch(function() {});
    })();
  </script>
</body>
</html>
